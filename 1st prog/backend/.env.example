# Local XAMPP example. Change the username/password/port for your MySQL setup.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/inventory_group_demo?charset=utf8mb4
SESSION_SECRET=
SESSION_HTTPS_ONLY=false

# Chronos is optional for the quick demo. The app uses the moving-average
# fallback until chronos-forecasting is installed and this flag is true.
CHRONOS_ENABLED=false
CHRONOS_MODEL=amazon/chronos-bolt-small
CHRONOS_DEVICE=cpu

# Optional assistant providers: none, groq, or ollama.
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b

# Demo special discount. Have the store owner confirm their required POS policy.
SPECIAL_DISCOUNT_RATE=0.20
